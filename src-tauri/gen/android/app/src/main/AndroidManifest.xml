<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- EXACT ALARMS for scheduled notifications (medication reminders, daily
         check-ins). Android's own docs name medication reminders as a legitimate
         use of SCHEDULE_EXACT_ALARM, so this is the permission we ARE eligible for.

         🚫 DO NOT ADD android.permission.USE_EXACT_ALARM.
         It is auto-granted with no runtime prompt, which is why past-me reached for
         it — but Google Play restricts it to apps whose CORE function is "alarm
         clock" or "calendar", and blocks upload otherwise (hit 2026-07-25, CHA-417).
         Chaos Command is a health tracker; declaring either category would be a
         false declaration. Convenience is not worth lying to the store.

         ✅ Removing it does NOT resurrect the v0.7.1 "scheduled alarms silently never
         register" bug. Verified in tauri-plugin-notification 2.3.3
         (android/.../TauriNotificationManager.kt, setExactIfPossible): the plugin
         already checks canScheduleExactAlarms() and FAILS SOFT to
         setAndAllowWhileIdle() — inexact, but it still fires through Doze. No
         SecurityException, no silently-dropped alarm.

         Practical effect: on Android <= 13 nothing changes (SCHEDULE_EXACT_ALARM is
         granted at install). On Android 14+ targeting API 33+ it is denied by default,
         so reminders become inexact — delivered late by minutes rather than to the
         second. A late reminder beats no reminder. An in-app opt-in that sends the
         user to ACTION_REQUEST_SCHEDULE_EXACT_ALARM would restore exactness; see the
         follow-up ticket. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Camera is required for QR code scanning on the sync page (html5-qrcode / getUserMedia) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
